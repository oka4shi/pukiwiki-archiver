{
  "name": "pukiwiki-archiver",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "download": "bun run src/download.ts",
    "download:common": "bun run src/download/common-pages.ts",
    "download:articles": "bun run src/download/articles.ts",
    "download:attachments": "bun run --sequential src/download/attachments.ts src/download/attachment-infos.ts",
    "convert:relative": "bun run src/convert/to-relative.ts",
    "convert:absolute": "bun run src/convert/to-absolute.ts",
    "fix": "biome check --write .",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check . && tsc --noEmit",
    "check:tsc": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@total-typescript/ts-reset": "^0.6.1"
  }
}
