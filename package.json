{
  "name": "pukiwiki-archiver",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "download": "bun run src/download.ts",
    "download:list": "bun run src/download/list.ts",
    "download:articles": "bun run src/download/articles.ts",
    "download:attachments": "bun run src/download/attachments.ts src/download/attachments-infos.ts",
    "fix": "run-s --continue-on-error format lint:tsc lint:eslint",
    "lint": "run-s --continue-on-error lint:tsc lint:eslint",
    "lint:tsc": "tsc --noEmit",
    "lint:eslint": "eslint . --fix",
    "format": "prettier --write .",
    "check": "run-s --continue-on-error check:tsc check:eslint check:prettier",
    "check:tsc": "tsc --noEmit",
    "check:eslint": "eslint .",
    "check:prettier": "prettier --check ."
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "@total-typescript/ts-reset": "^0.6.1",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "jiti": "^2.7.0",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.8.3",
    "typescript-eslint": "^8.59.3"
  }
}
